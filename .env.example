# Base de datos (Neon). En Vercel la integración de Neon crea estas dos variables.
DATABASE_URL="postgresql://usuario:clave@ep-xxxx-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://usuario:clave@ep-xxxx.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Auth.js: genera uno con `npx auth secret` o `openssl rand -base64 32`
AUTH_SECRET=""

# Vercel Cron envía este secreto en el encabezado Authorization (ERS 4.6)
CRON_SECRET=""

# Resend. Sin dominio verificado, Resend solo entrega al correo dueño de la cuenta:
# por eso en la demo todos los correos se redirigen a CORREO_REDIRECCION.
RESEND_API_KEY=""
CORREO_REMITENTE="Surtigas Turnos <onboarding@resend.dev>"
CORREO_REDIRECCION="tu-correo@gmail.com"

# Vercel Blob (soportes de las ausencias). Al conectar un Blob store privado, Vercel agrega BLOB_STORE_ID
# y la app usa OIDC. Solo para pruebas locales contra Blob puedes usar un BLOB_READ_WRITE_TOKEN.
BLOB_READ_WRITE_TOKEN=""

# URL pública (para los enlaces de los correos). En Vercel se deduce sola si no la pones.
APP_URL="http://localhost:3000"

# Contraseña de las cuentas de demostración que crea el seed. "false" oculta el atajo "ver como" del login.
SEED_PASSWORD="Surtigas2026"
DEMO_PASSWORD_PUBLICA="true"
